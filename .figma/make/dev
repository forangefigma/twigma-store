#!/usr/bin/env bash
# Start the Vite dev server. Runs for the whole session; killed on project close.
set -euo pipefail

cd "$(dirname "$0")/../.."

# Load PORT (and any other vars) from the env file next to this script.
set -a
# shellcheck disable=SC1091
source "$(dirname "$0")/env"
set +a

exec npx vite --host --port "${PORT}" --strictPort
