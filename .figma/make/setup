#!/usr/bin/env bash
# First-open setup: system-level dependencies. Cached after first run.
# This project only needs Node.js + npm, which the host provides, so there's
# nothing to install here. Verify the toolchain is present and exit cleanly.
set -euo pipefail

echo "Checking toolchain..."
command -v node >/dev/null 2>&1 || { echo "node not found on PATH" >&2; exit 1; }
command -v npm  >/dev/null 2>&1 || { echo "npm not found on PATH" >&2; exit 1; }
echo "node $(node --version), npm $(npm --version)"
echo "Setup complete."
